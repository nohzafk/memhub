# The versions provision-ct.sh installs, pinned; nothing else in the repo names
# a version. deploy.sh reads nothing here.
#
# provision-ct.sh reads these when it builds the container and skips a tool that
# is already installed, so an edit here does not upgrade an existing container.
# Nothing verifies a checksum: the uv installer is fetched by version over HTTPS.

# uv inside the container, installed by provision-ct.sh.
UV_VERSION="0.12.5"
