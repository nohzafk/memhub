# Everything memhub downloads, pinned. An upgrade is an edit here plus a
# `deploy.sh` run; nothing else in the repo names a version.
#
# The sha256 lines are not decoration: deploy.sh verifies each download and
# refuses to install a file that does not match, so a mirror swap or a truncated
# transfer fails loudly instead of producing a server that answers nonsense.

# uv inside the container, installed by provision-ct.sh.
UV_VERSION="0.12.5"
